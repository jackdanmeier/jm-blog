---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="jm-blog" description="A personal blog">
  <h1>Posts</h1>
  {posts.length === 0 && <p>No posts yet. Check back soon.</p>}
  <ol class="post-list">
    {posts.map(post => (
      <li>
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))}
  </ol>
</BaseLayout>
